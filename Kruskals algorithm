#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int findParent(int v, vector<int>& parent) {
    if (parent[v] == v)
        return v;

    return parent[v] = findParent(parent[v], parent);
}

void unionSets(int u, int v, vector<int>& parent,
               vector<int>& rank) {
    u = findParent(u, parent);
    v = findParent(v, parent);

    if (u == v)
        return;

    if (rank[u] < rank[v])
        parent[u] = v;
    else if (rank[u] > rank[v])
        parent[v] = u;
    else {
        parent[v] = u;
        rank[u]++;
    }
}

void kruskal(int V, vector<vector<int>>& edges) {
    // Sort edges by weight
    sort(edges.begin(), edges.end(),
         [](const vector<int>& a, const vector<int>& b) {
             return a[2] < b[2];
         });

    vector<int> parent(V);
    vector<int> rank(V, 0);

    for (int i = 0; i < V; i++)
        parent[i] = i;

    vector<vector<int>> mst;
    int cost = 0;

    for (auto edge : edges) {
        int u = edge[0];
        int v = edge[1];
        int weight = edge[2];

        if (findParent(u, parent) != findParent(v, parent)) {
            mst.push_back({u, v, weight});
            cost += weight;

            unionSets(u, v, parent, rank);
        }
    }

    cout << "Minimum Spanning Tree:\n";
    for (auto edge : mst) {
        cout << "(" << char(edge[0] + 'A') << ", "
             << char(edge[1] + 'A') << ", "
             << edge[2] << ")\n";
    }

    cout << "Total cost = " << cost << endl;

    if (mst.size() != V - 1)
        cout << "Graph is disconnected; MST does not exist.\n";
}

int main() {
    int V = 4;

    vector<vector<int>> edges = {
        {0, 1, 2},  
        {1, 2, 3}, 
        {0, 2, 1},  
        {2, 3, 4},  
        {1, 3, 5}  
    };

    kruskal(V, edges);

    return 0;
}
